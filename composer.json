{
    "name": "jeffersongoncalves/kv-cli",
    "description": "Read-only CLI to inspect Redis (keys, values of any type, INFO) through named connection profiles with SSH tunnel support and table/json/csv output, built for pairing with an LLM.",
    "keywords": ["cli", "redis", "key-value", "cache", "laravel-zero"],
    "homepage": "https://github.com/jeffersongoncalves/kv-cli",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Jefferson Goncalves",
            "email": "jeffersongoncalves@users.noreply.github.com"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "jeffersongoncalves/laravel-zero-console": "^1.0",
        "jeffersongoncalves/laravel-zero-json-config": "^1.0",
        "jeffersongoncalves/laravel-zero-self-update": "^1.0",
        "laravel-zero/framework": "^12.0",
        "laravel/pint": "^1.25",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^3.8|^4.1",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-mockery": "^2.0",
        "predis/predis": "^2.2|^3.0",
        "symfony/process": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "build": ["php kv app:build kv"],
        "lint": "./vendor/bin/pint",
        "test:lint": "./vendor/bin/pint --test",
        "test:unit": "./vendor/bin/pest --parallel",
        "test:types": "./vendor/bin/phpstan analyse --memory-limit=256M",
        "phpstan": "./vendor/bin/phpstan analyse --memory-limit=256M",
        "phpstan-baseline": "./vendor/bin/phpstan analyse --generate-baseline --memory-limit=256M",
        "test": [
            "@test:unit",
            "@test:lint"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": ["builds/kv"]
}
